# Токен Telegram-бота
BOT_TOKEN=your_telegram_bot_token_here

# ID вашей Google Таблицы
SPREADSHEET_ID=your_google_spreadsheet_id_here

# Полный JSON-ключ сервисного аккаунта Google в виде одной строки (используется в google_db.py)
GOOGLE_CREDENTIALS_JSON={"type": "service_account", "project_id": "...", ...}

# URL вашего сервера (если деплоите на Render/Heroku/VPS)
# Если запускаете локально для теста, можно оставить пустым
WEBHOOK_URL=https://tgbot-8yez.onrender.com

# Порт (обычно подставляется хостингом автоматически)
PORT=8080
